{
  "expo": {
    "name": "Kerf",
    "slug": "kerf-construction",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kerf",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F1113",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1113"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hasanzafar.kerf",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Kerf"
      }
    },
    "android": {
      "package": "com.hasanzafar.kerf",
      "adaptiveIcon": {
        "backgroundColor": "#0F1113",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-iap",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "owner": "keyfive",
    "extra": {
      "eas": {
        "projectId": "7ba60f88-2c27-464a-b817-455f3ef0df36"
      }
    }
  }
}
